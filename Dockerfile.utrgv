FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ABET_ENV=production \
    ABET_DATABASE=/data/utrgv_mece.db \
    ABET_UPLOAD_FOLDER=/data/uploads \
    UTRGV_EDINBURG_ABET_DB=/legacy/edinburg_abet_data.db

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY abet_platform ./abet_platform
COPY utrgv_wsgi.py ./
RUN adduser --disabled-password --gecos "" --uid 10001 appuser \
    && mkdir -p /data/uploads /legacy \
    && chown -R appuser:appuser /app /data /legacy
USER appuser
EXPOSE 8000
CMD ["gunicorn", "--bind=0.0.0.0:8000", "--workers=2", "--threads=4", "--timeout=120", "utrgv_wsgi:app"]
